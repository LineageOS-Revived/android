	<project name="droid-legacy/android_packages_apps_DocumentsUI" path="packages/apps/DocumentsUI" />

	<remove-project name="LineageOS/android_packages_apps_ManagedProvisioning" />
	<project name="droid-legacy/android_packages_apps_ManagedProvisioning" path="packages/apps/ManagedProvisioning" />

	<remove-project name="LineageOS/android_packages_apps_Nfc" />
	<project name="droid-legacy/android_packages_apps_Nfc" path="packages/apps/Nfc" />

	<remove-project name="LineageOS/android_packages_modules_Bluetooth" />
	<project name="droid-legacy/android_packages_modules_Bluetooth" path="packages/modules/Bluetooth" />

	<remove-project name="LineageOS/android_packages_modules_CellBroadcastService" />
	<project name="droid-legacy/android_packages_modules_CellBroadcastService" path="packages/modules/CellBroadcastService" />

	<remove-project name="LineageOS/android_packages_modules_IntentResolver" />
	<project name="droid-legacy/android_packages_modules_IntentResolver" path="packages/modules/IntentResolver" />

	<remove-project name="LineageOS/android_packages_modules_Permission" />
